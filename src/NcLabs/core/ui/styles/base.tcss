/* Global screen styling */
Screen {
    background: $surface;
}

/* Centered welcome text */
#welcome {
    width: 100%;
    height: 100%;
    content-align: center middle;
    text-align: center;
    color: white;
}

/* Footer */
#footer {
    background: #b8b8b8ff;
    color: #000000;
    width: 100%;
    height: 1;
}

/* Bottom input bar */
#prompt-shell {
    dock: bottom;
    height: 1;
    background: transparent;
    border: none;
    padding-left: 0;
}

/* Focus highlight */
#prompt-shell:focus {
    background: transparent;
    color: #ffffff;
}
