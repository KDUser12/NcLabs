/* src/NcLabs/ui/style.tcss */

Screen {
}

/* Centered welcome text */
#welcome {
    width: 100%;
    height: 100%;
    content-align: center middle; /* 👈 aligne horizontalement ET verticalement */
    text-align: center;
}

/* footer */
#footer {
    background: #b8b8b8ff;
    color: #000000;
    width: 100%;
    height: 1;
}

/* Bottom input bar like Neovim */
#prompt-shell {
    dock: bottom;
    height: 1;
    background: transparent;
    border: none;
    padding-left: 0;
}

/* focused input highlighting */
#prompt-shell:focus {
    background: transparent;
    color: #ffffff;
}
